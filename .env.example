# Local-only demonstration credentials. Copy this file to .env and replace each password.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=transit_demo
MYSQL_HOST_PORT=3307
MYSQL_APP_USER=transit_app
MYSQL_APP_PASSWORD=change-me-app-password
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=change-me-cdc-password
DEBEZIUM_SERVER_ID=184054

MONGO_DATABASE=transit_demo
MONGO_HOST_PORT=27017
MONGO_URI=mongodb://mongo:27017

# Collector modes: synthetic, live, replay
COLLECTOR_MODE=synthetic
COLLECT_INTERVAL_SECONDS=10
TRANSIT_API_URL=https://api-v3.mbta.com/vehicles?filter[route]=1&include=trip
TRANSIT_API_KEY=
SYNTHETIC_SNAPSHOT_PATH=/data/fixtures/synthetic_vehicle_snapshot.json
SYNTHETIC_REFRESH_TIMESTAMPS=true
REPLAY_CSV_PATH=/data/sample/synthetic_trip_observations.csv
REPLAY_BATCH_SIZE=25
REPLAY_DELAY_SECONDS=0.25

WEB_PORT=3000
CDC_HEALTH_PORT=8080
LOG_LEVEL=INFO
MAP_TILE_URL=
